<Layouts.app flash={@flash} active={:dashboard}>
  <:actions>
    <button
      id="scan-btn"
      phx-click="trigger-node-scan"
      class="btn btn-sm border-line bg-transparent font-normal"
      title="Send a SECoP discovery broadcast"
    >
      <.icon name="hero-signal-micro" class="size-4" /> Scan
    </button>
    <button
      id="connect-btn"
      onclick="connect_modal.showModal()"
      phx-click="open_connect_modal"
      class="btn btn-sm btn-primary"
    >
      <.icon name="hero-link-micro" class="size-4" /> Connect node
    </button>
  </:actions>

  <%= if @active_nodes != %{} and @current_node == nil do %>
    <%!-- the selected node has no data (yet): keep the tabs so the others
         stay reachable --%>
    <div class="flex flex-col gap-3">
      <.node_tabs
        active_nodes={@active_nodes}
        hidden_node_ids={@hidden_node_ids}
        current_uuid={get_in(@active_nodes, [@selected_node_id, :uuid])}
      />
      <.node_unavailable node={@active_nodes[@selected_node_id]} />
    </div>
  <% end %>

  <%= if @active_nodes != %{} and @current_node != nil do %>
    <div class="flex flex-col gap-3">
      <.node_tabs
        active_nodes={@active_nodes}
        hidden_node_ids={@hidden_node_ids}
        current_uuid={@current_node.uuid}
      />

      <%!-- header, rail and cards on the left; the module panel sits on the
           right from lg, level with the header. Between lg and xl the rail is
           hidden (the cards show the same names and statuses); below lg the
           panel follows the cards. --%>
      <.stale_banner conn_state={conn_state(@active_nodes[@current_node.node_id])} />

      <div class="flex flex-col gap-3 lg:flex-row lg:items-start">
        <div class="flex min-w-0 flex-1 flex-col gap-3">
          <.node_header
            node={@current_node}
            state_map={@active_nodes[@current_node.node_id]}
            status_counts={status_counts(@status_map)}
          >
            <:extra>
              <.link
                navigate={~p"/browse/node/#{@current_node.uuid}?#{%{module: @selected_module}}"}
                class="inline-flex h-6 items-center gap-1 rounded-full border border-line px-2.5 text-[11px] text-muted hover:bg-base-200 hover:text-base-content"
                id="open-history"
              >
                <.icon name="hero-clock-micro" class="size-3.5" /> History
              </.link>
            </:extra>
          </.node_header>

          <div class="flex flex-col gap-3 xl:flex-row xl:items-start">
            <.module_rail
              node={@current_node}
              selected={@selected_module}
              mode={:live}
              node_state={conn_state(@active_nodes[@current_node.node_id])}
              class="lg:max-xl:hidden"
            />

            <div class="min-w-0 flex-1">
              <.module_grid
                node={@current_node}
                selected={@selected_module}
                node_state={conn_state(@active_nodes[@current_node.node_id])}
                status_map={@status_map}
              />
            </div>
          </div>
        </div>

        <.inspector_panel :if={@selected_module} id="inspector">
          <.module_detail
            module={selected_module(@current_node, @selected_module)}
            node={@current_node}
            mode={:live}
            plot_param={@plot_param}
            plot_id={plot_id(@current_node, @selected_module, @plot_param)}
            chart_height={380}
            node_state={conn_state(@active_nodes[@current_node.node_id])}
          />
        </.inspector_panel>
      </div>
    </div>
  <% end %>

  <%= if @active_nodes == %{} do %>
    <div class="mx-auto mt-16 flex max-w-2xl flex-col gap-4">
      <div class="flex items-center gap-3 text-muted">
        <span class="loading loading-ring loading-sm"></span>
        Waiting for SEC nodes. Nodes on the local network are discovered automatically.
      </div>
      <.connect_node />
    </div>
  <% end %>

  <.modal id="connect_modal" title="" show={@show_connect_modal}>
    <.connect_node />
  </.modal>
</Layouts.app>
