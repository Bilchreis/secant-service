<Layouts.app flash={@flash} current_user={@current_user}>
  <%= if @active_nodes != %{} and @current_node != nil do %>
    <div class="flex">
      <div class="sticky   top-0 self-start ">
        <.module_indicators
          node={@current_node}
          node_state={@active_nodes[@current_node.node_id].state}
          values={@values}
          node_id_str={@current_node.node_id_str}
        />
      </div>

      <div class="flex-1">
        <ul class="flex flex-wrap text-sm font-medium text-center text-neutral-content items-cente ml-4">
          <%= for {node_id, node} <- @active_nodes, not MapSet.member?(@hidden_node_ids, node_id) do %>
            <li class="me-2 mb-2">
              <.node_button
                equipment_id={node.equipment_id}
                pubsub_topic={node.pubsub_topic}
                uuid={node.uuid}
                current={node.uuid == @current_node.uuid}
                state={node.state}
                connstate={node.active}
              />
            </li>
          <% end %>
          <%= if MapSet.size(@hidden_node_ids) > 0 do %>
            <li class="me-2 mb-2">
              <div class="dropdown">
                <div
                  tabindex="0"
                  role="button"
                  class="min-w-[240px] border-4 border-gray-500 bg-neutral hover:bg-neutral/80 text-neutral-content text-left font-bold py-2 px-4 rounded font-mono cursor-pointer"
                >
                  <div class="text-xl font-sans flex items-center gap-2">
                    <.icon name="hero-eye-slash" class="w-5 h-5" /> Hidden
                  </div>
                  <div class="text-sm text-neutral-content/80 opacity-60">
                    {MapSet.size(@hidden_node_ids)} node(s)
                  </div>
                  <div class="flex gap-2">
                    <div class="px-2 py-0.5 rounded-full text-base-content bg-base-200/80 font-mono">
                      click to view
                    </div>
                  </div>
                </div>
                <div
                  tabindex="0"
                  class="dropdown-content z-20 mt-2 w-64 rounded-box bg-base-100 border border-base-300 shadow-lg p-2 flex flex-col gap-1"
                >
                  <%= for {node_id, node} <- @active_nodes, MapSet.member?(@hidden_node_ids, node_id) do %>
                    <.hidden_node_row
                      equipment_id={node.equipment_id}
                      pubsub_topic={node.pubsub_topic}
                      uuid={node.uuid}
                    />
                  <% end %>
                </div>
              </div>
            </li>
          <% end %>
          <li class="flex flex-col me-2 mb-2 justify-center">
            <button
              onclick="connect_modal.showModal()"
              phx-click="open_connect_modal"
              class="btn btn-primary justify-between"
            >
              <.icon name="hero-link" class="" />
              <div class="text-lg">Connect Node</div>
            </button>

            <button
              phx-click="trigger-node-scan"
              class="mt-2 btn btn-primary justify-between"
            >
              <.icon name="hero-globe-alt" class="" />
              <div class="text-lg">Trigger Scan</div>
            </button>
          </li>
        </ul>

        <.dash_sec_node
          node={@current_node}
          state_map={@active_nodes[@current_node.node_id]}
        />
      </div>
    </div>
  <% else %>
    <div class="max-w-5xl align-middle mx-auto mt-20">
      <.connect_node />
    </div>
  <% end %>

  <.modal
    id="connect_modal"
    title=""
    show={@show_connect_modal}
  >
    <.connect_node />
  </.modal>

  <.modal
    :if={@selected_parameter != nil}
    id="parameter-history-modal"
    on_cancel={JS.push("close_parameter_graph")}
    show={true}
  >
    <.live_component
      module={HistoryDB}
      id={"parameter-plot:" <> to_string(@selected_parameter.id)}
      secop_obj={@selected_parameter}
      plot_mode={:historical}
      class=""
    />
  </.modal>
</Layouts.app>
