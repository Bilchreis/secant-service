<Layouts.app flash={@flash} active={:browse}>
  <:actions>
    <.link
      navigate={~p"/browse"}
      class="btn btn-sm border-line bg-transparent font-normal"
      id="back-to-list"
    >
      <.icon name="hero-arrow-left-micro" class="size-4" /> All nodes
    </.link>
  </:actions>

  <%= if @node do %>
    <div class="flex flex-col gap-3">
      <.node_header node={@node}>
        <:extra>
          <span class="rounded-full border border-line px-2.5 py-0.5 text-[11px] text-muted">
            {@node.state} · recorded data
          </span>
          <.link
            :if={@node.state == :active}
            navigate={
              ~p"/dashboard?#{%{node: "#{@node.host}:#{@node.port}", module: @selected_module}}"
            }
            class="inline-flex h-6 items-center gap-1 rounded-full border border-line px-2.5 text-[11px] text-muted hover:bg-base-200 hover:text-base-content"
            id="open-live"
          >
            <span class="size-2 rounded-full bg-st-idle"></span> Live
          </.link>
        </:extra>
      </.node_header>

      <div class="flex flex-col gap-3 lg:flex-row lg:items-start">
        <.module_rail node={@node} selected={@selected_module} mode={:historical} />

        <section
          :if={@selected_module}
          id="history-panel"
          class="min-w-0 flex-1 rounded-box border border-line bg-base-100 p-4"
        >
          <.module_detail
            module={selected_module(@node, @selected_module)}
            node={@node}
            mode={:historical}
            plot_param={@plot_param}
            plot_id={plot_id(@node, @selected_module, @plot_param)}
            chart_height={520}
          />
        </section>
      </div>
    </div>
  <% else %>
    <div class="mx-auto mt-16 max-w-xl rounded-box border border-line bg-base-100 p-6 text-center">
      <p class="font-semibold">Node not found</p>
      <p class="mt-1 text-muted">It may have been purged from the database.</p>
    </div>
  <% end %>
</Layouts.app>
